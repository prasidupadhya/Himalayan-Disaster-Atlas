{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "es2022"],
    "strict": true, "allowJs": true, "noEmit": true, "esModuleInterop": true,
    "module": "esnext", "moduleResolution": "bundler", "resolveJsonModule": true,
    "isolatedModules": true, "jsx": "react-jsx", "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["apps/web/**/*.ts", "apps/web/**/*.tsx", "packages/**/*.ts", "tests/**/*.ts", "*.ts"],
  "exclude": ["node_modules", "apps/web/out", "apps/web/.next"]
}
