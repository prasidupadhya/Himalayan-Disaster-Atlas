{
  "name": "himalayan-disaster-atlas",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/prepare-software-notices.mjs && node scripts/prepare-map-worker.mjs && npm run dev --workspace @atlas/web",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:python": ".venv/bin/python -m unittest discover -s tests/python -v",
    "test:e2e": "playwright test",
    "data:sample": ".venv/bin/python -m pipelines.atlas_pipeline.sample",
    "data:admin": ".venv/bin/python -m pipelines.atlas_pipeline.admin_boundaries",
    "data:validate": ".venv/bin/python -m pipelines.atlas_pipeline.validate",
    "security:check": "node scripts/check-security.mjs",
    "check": "npm run contracts:check && npm run data:sample && npm run data:validate && npm run test:python && npm run test && npm run typecheck && npm run lint && npm run lint:python && npm run build",
    "lint:python": ".venv/bin/ruff check pipelines processing tests/python",
    "test:hydration": "playwright test --config playwright.hydration.config.ts",
    "data:terrain": ".venv/bin/python -m pipelines.atlas_pipeline.terrain",
    "data:mountains": ".venv/bin/python -m pipelines.atlas_pipeline.mountains",
    "data:rivers": ".venv/bin/python -m pipelines.atlas_pipeline.rivers",
    "data:glaciers": ".venv/bin/python -m pipelines.atlas_pipeline.glaciers",
    "data:glacial-lakes": ".venv/bin/python -m pipelines.atlas_pipeline.glacial_lakes",
    "data:hydrology": ".venv/bin/python -m pipelines.atlas_pipeline.hydrology",
    "data:rainfall": ".venv/bin/python -m pipelines.atlas_pipeline.rainfall",
    "data:disaster-events": ".venv/bin/python -m pipelines.atlas_pipeline.disaster_events",
    "data:earthquakes": ".venv/bin/python -m pipelines.atlas_pipeline.earthquakes",
    "data:floods": ".venv/bin/python -m pipelines.atlas_pipeline.floods",
    "data:landslides": ".venv/bin/python -m pipelines.atlas_pipeline.landslides",
    "data:hydropower": ".venv/bin/python -m pipelines.atlas_pipeline.hydropower",
    "data:infrastructure": ".venv/bin/python -m pipelines.atlas_pipeline.infrastructure --snapshot data/raw/osm/nepal-infrastructure-2026-09-07.json --roads-dir data/raw/osm/infrastructure",
    "data:population": ".venv/bin/python -m pipelines.atlas_pipeline.population --source data/raw/population/npl_pop_2025_CN_100m_R2025A_v1.tif",
    "data:exposure": ".venv/bin/python -m pipelines.atlas_pipeline.exposure",
    "data:satellite": ".venv/bin/python -m pipelines.atlas_pipeline.satellite",
    "data:climate": ".venv/bin/python -m pipelines.atlas_pipeline.climate",
    "data:water-change": ".venv/bin/python -m pipelines.atlas_pipeline.water_change",
    "data:time-machine": ".venv/bin/python -m pipelines.atlas_pipeline.time_machine",
    "data:search": ".venv/bin/python -m pipelines.atlas_pipeline.search",
    "data:hazard-graph": ".venv/bin/python -m pipelines.atlas_pipeline.hazard_graph",
    "data:scenarios": ".venv/bin/python -m pipelines.atlas_pipeline.scenarios",
    "data:rag": ".venv/bin/python -m pipelines.atlas_pipeline.rag",
    "data:provenance": ".venv/bin/python -m pipelines.atlas_pipeline.provenance",
    "profile:performance": "node scripts/profile-performance.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "release:check": "node scripts/release-check.mjs",
    "preview:cloudflare": "node scripts/preview-cloudflare.mjs",
    "deploy:cloudflare": "wrangler deploy",
    "upload:cloudflare": "wrangler versions upload",
    "test:e2e:cloudflare": "playwright test --config playwright.cloudflare.config.ts",
    "contracts:generate": "node scripts/compile-validators.mjs",
    "contracts:check": "node scripts/compile-validators.mjs --check",
    "build:research": "node scripts/build.mjs --research",
    "test:e2e:public": "playwright test --config playwright.public.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.4",
    "typescript": "^5.9.0",
    "vitest": "4.1.11",
    "wrangler": "4.130.0"
  },
  "license": "MIT",
  "overrides": {
    "sharp": "0.35.4"
  }
}
